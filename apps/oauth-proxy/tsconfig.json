{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["@cloudflare/workers-types"]
  },
  // Test files are excluded here: they import `bun:test`, whose ambient types (via the
  // `bun` type root) declare globals (Request/Response/fetch/...) that collide with
  // @cloudflare/workers-types' own Workers-runtime globals if both are loaded in the same
  // program. `bun test` type-strips and runs them directly regardless (see package.json).
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
