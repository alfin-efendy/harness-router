{
  "name": "ryuzi-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/cockpit && tsc --noEmit -p packages/ui && tsc --noEmit -p apps/oauth-proxy",
    "cockpit:dev": "cd apps/cockpit && bun run tauri dev",
    "cockpit:build": "cd apps/cockpit && bun run tauri build",
    "e2e:cockpit": "bun run --cwd apps/cockpit e2e",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "check:agentic-cleanup": "bun scripts/check-agentic-cleanup.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@happy-dom/global-registrator": "^20.10.6",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "latest",
    "typescript": "^5"
  },
  "overrides": {
    "fast-uri": "^3.1.5",
    "brace-expansion": "^5.0.9",
    "postcss": "^8.5.18",
    "hono": "^4.12.34",
    "ip-address": "^10.3.1",
    "js-yaml": "^4.3.1",
    "nanoid": "^3.3.17",
    "undici": "^7.29.0"
  }
}
